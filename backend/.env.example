# Main MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_strong_random_secret_here

# Port (Render sets this automatically)
PORT=5000

# ── Forgot-password OTP email ──────────────────────────────
# Set ONE of the options below. The first one that is set is used.

# Option A (recommended): Brevo - free, 300 emails/day, HTTPS API (works on Render free)
# API key: Brevo dashboard -> top-right menu -> SMTP & API -> API Keys -> Generate
# Sender: Brevo dashboard -> Senders, Domains & Dedicated IPs -> Senders -> Add a sender
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
MAIL_FROM_NAME=Smart Interview Prep

# Option B: Resend - free, but it only delivers to other people after you
# verify your own domain and set RESEND_FROM to an address on that domain.
RESEND_API_KEY=
RESEND_FROM=

# Option C: Gmail SMTP - local development only (Render free blocks SMTP ports)
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_gmail_app_password

# Coding Practice execution (Optional - defaults to https://ce.judge0.com)
JUDGE0_URL=https://ce.judge0.com

# Optional Email Encryption & Secondary DB (if using database-stored credentials)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=
EMAIL_MONGO_URI=
