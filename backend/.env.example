# Main MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_strong_random_secret_here

# Port (Render sets this automatically)
PORT=5000

# Recommended for Production on Render Free Tier (HTTP API over Port 443):
# Get a free API key in 30 seconds at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# Alternative: SendGrid HTTP API (Port 443)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Local / Standard SMTP (Note: Render Free Tier blocks SMTP ports 25, 465, 587)
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_gmail_app_password

# Coding Practice execution (Optional - defaults to https://ce.judge0.com)
JUDGE0_URL=https://ce.judge0.com

# Optional Email Encryption & Secondary DB (if using database-stored credentials)
EMAIL_ENCRYPTION_KEY=7dda242ba57bf81f7d654d69f371b0b986d3d17aa69b7ace1d592c19135d66db
EMAIL_MONGO_URI=
